{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kb://agent-bridge/capability.schema.json",
  "title": "Bridge capability",
  "type": "object",
  "required": ["name", "description", "params", "availability", "approvalRequired", "resultSchema"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "params": { "type": "object" },
    "availability": { "enum": ["available", "degraded", "unavailable"] },
    "approvalRequired": { "type": "boolean" },
    "resultSchema": { "type": "object" }
  }
}
