{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kb://agent-bridge/plan-draft.schema.json",
  "title": "Plan draft inside plan-submit",
  "type": "object",
  "required": ["title", "ops"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "ops": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["kind", "resourceId"],
        "properties": {
          "kind": { "enum": ["write", "move", "trash"] },
          "resourceId": { "type": "string", "minLength": 1 },
          "content": { "type": "string" },
          "expectedHash": { "type": ["string", "null"] },
          "toRelPath": { "type": "string" }
        }
      }
    }
  },
  "description": "文件内 approved / approve / contentHash 不是本结构的字段，写入也会被忽略，且不会触发 apply。"
}
