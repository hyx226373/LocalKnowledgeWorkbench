 "components": [
  {
   "id": "button",
   "name": "按钮（主/次/幽灵）",
   "axis": "chrome",
   "hook": ".kb-button, .kb-button--secondary, .kb-button--ghost",
   "states": {
    "default": ".kb-button",
    "hover": ":hover",
    "active": ":active",
    "focus-visible": ":focus-visible",
    "disabled": ":disabled",
    "selected": "[aria-pressed=\"true\"]（开关按钮按下，例如 PDF“深色滤镜”、编辑器“预览”）",
    "dragging": null,
    "drag-over": null
   },
   "note": ""
  },
  {
   "id": "input",
   "name": "输入框/下拉框/多行文本",
   "axis": "chrome",
   "hook": ".kb-input, .kb-select, .kb-textarea",
   "states": {
    "default": ".kb-input",
    "hover": ":hover",
    "active": null,
    "focus-visible": ":focus-visible",
    "disabled": ":disabled",
    "selected": null,
    "dragging": null,
    "drag-over": null
   },
   "note": ""
  },
  {
   "id": "toggle",
   "name": "复选开关",
   "axis": "chrome",
   "hook": ".kb-toggle",
   "states": {
    "default": ".kb-toggle",
    "hover": ":hover",
    "active": null,
    "focus-visible": ".kb-toggle input:focus-visible",
    "disabled": "[aria-disabled=\"true\"]",
    "selected": ".kb-toggle input:checked（勾选）",
    "dragging": null,
    "drag-over": null
   },
   "note": "",
   "since": "2.0.0"
  },
  {
   "id": "tab",
   "name": "标签页（dockview）",
   "axis": "chrome",
   "hook": ".kb-dock .dv-tab",
   "states": {
    "default": ".dv-tab",
    "hover": ":hover",
    "active": ":active",
    "focus-visible": ":focus-visible",
    "disabled": null,
    "selected": ".dv-active-tab（所在分组激活时外层有 .dv-active-group）",
    "dragging": ".dv-tab[data-dragging=\"true\"]（正被拖动的标签）",
    "drag-over": ".kb-dock .dv-drop-target-selection（拖到分组上方时出现的覆盖层，颜色来自 --kb-color-drag-over）"
   },
   "note": "未加载的后台标签：.dv-tab [data-lazy=\"pending\"]（冷启动分级加载，切到它时才加载内容）"
  },
  {
   "id": "group",
   "name": "分栏分组（可做成卡片）",
   "axis": "chrome",
   "hook": ".kb-dock .dv-groupview, .kb-dock .dv-tabs-and-actions-container",
   "states": {
    "default": ".dv-groupview",
    "hover": null,
    "active": ".dv-active-group（当前激活分组）",
    "focus-visible": null,
    "disabled": null,
    "selected": null,
    "dragging": null,
    "drag-over": ".kb-dock .dv-drop-target-selection"
   },
   "note": ""
  },
  {
   "id": "tree-row",
   "name": "目录树行/收藏行",
   "axis": "chrome",
   "hook": ".kb-tree-row",
   "states": {
    "default": ".kb-tree-row",
    "hover": ":hover",
    "active": ":active",
    "focus-visible": ":focus-visible",
    "disabled": "[aria-disabled=\"true\"]（文件已不在原处）",
    "selected": "[aria-selected=\"true\"]（当前激活标签对应的文件）",
    "dragging": null,
    "drag-over": "[data-drag-over=\"true\"]（预留）"
   },
   "note": "被忽略的项（显示被忽略的项时）：.kb-tree-row.ignored"
  },
  {
   "id": "collection-row",
   "name": "工作资料行（侧栏“本工作的资料”）",
   "axis": "chrome",
   "hook": ".kb-collection, .kb-collection-row",
   "states": {
    "default": ".kb-collection-row",
    "hover": ":hover",
    "active": ":active",
    "focus-visible": ":focus-visible",
    "disabled": "[aria-disabled=\"true\"]（原文件已不在原处）",
    "selected": "[aria-selected=\"true\"]（当前激活标签）",
    "dragging": null,
    "drag-over": null
   },
   "note": "已打开为标签：[data-open=\"true\"]",
   "since": "2.0.0"
  },
  {
   "id": "splitter",
