{
  "id": "test.loop",
  "name": "卡死测试插件",
  "version": "0.1.0",
  "publisher": "test",
  "description": "测试看门狗与逐次调用超时：文件内容决定行为（busy-open / busy-action / hang-open / flood / ok）。",
  "engines": { "workbench": "^0.2.0", "adapterApi": "^0.1.0" },
  "main": "dist/index.js",
  "activationEvents": ["onAdapter:test.loop.reader"],
  "sandbox": "iframe",
  "contributes": {
    "adapters": [
      {
        "id": "test.loop.reader",
        "title": "卡死测试",
        "sourceKinds": ["file"],
        "displayMode": "in-app-reader",
        "match": { "file": { "extensions": ["loop"] }, "priority": 100 },
        "permissions": [{ "id": "read", "kind": "fs.read", "scope": "ask-per-root", "extensions": ["loop"], "reason": "读取 .loop 测试文件" }],
        "stateSchemaVersion": 1
      }
    ]
  }
}
