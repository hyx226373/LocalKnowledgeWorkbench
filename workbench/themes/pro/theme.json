{
  "id": "kb.theme.pro",
  "name": "专业工具（占位）",
  "version": "0.1.0",
  "description": "方向 B：紧凑、等宽强调、VS Code 风格。占位实现，等待主题外包定稿。",
  "engines": {
    "workbench": "^0.2.0",
