{
  "name": "@kb/indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fork": {
      "types": "./dist/fork.d.ts",
      "import": "./dist/fork.js"
    }
