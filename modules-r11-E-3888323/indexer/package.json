  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "pdf-lib": "^1.17.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
